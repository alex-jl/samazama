<?xml version="1.0" encoding="utf-8"?><!--
   The web view's data holds the Bookmeter session cookie, so it is never
   backed up or transferred to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
